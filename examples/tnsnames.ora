# --- Oracle RAC Cluster ---

RACDB =
  (DESCRIPTION =
    (ADDRESS_LIST =
      (FAILOVER = ON)
      (LOAD_BALANCE = ON)
      (ADDRESS = (PROTOCOL = TCP)(HOST = racnode1.example.com)(PORT = 1521))
      (ADDRESS = (PROTOCOL = TCP)(HOST = racnode2.example.com)(PORT = 1521))
      (ADDRESS = (PROTOCOL = TCP)(HOST = racnode3.example.com)(PORT = 1521))
    )
    (CONNECT_DATA =
      (SERVICE_NAME = racdb_svc.example.com)
      (SERVER = DEDICATED)
      (FAILOVER_MODE =
        (TYPE = SELECT)
        (METHOD = BASIC)
        (RETRIES = 60)
        (DELAY = 3)
      )
    )
    (EXPIRE_TIME = 3)
  )

RACDB_BATCH =
  (DESCRIPTION =
    (ADDRESS_LIST =
      (LOAD_BALANCE = ON)
      (ADDRESS = (PROTOCOL = TCP)(HOST = racnode1.example.com)(PORT = 1521))
      (ADDRESS = (PROTOCOL = TCP)(HOST = racnode2.example.com)(PORT = 1521))
      (ADDRESS = (PROTOCOL = TCP)(HOST = racnode3.example.com)(PORT = 1521))
    )
    (CONNECT_DATA =
      (SERVICE_NAME = racdb_batch.example.com)
      (SERVER = DEDICATED)
    )
  )

# --- Connection Pooling / DRCP ---

POOLDB =
  (DESCRIPTION =
    (ADDRESS = (PROTOCOL = TCP)(HOST = dbprod01.example.com)(PORT = 1521))
    (CONNECT_DATA =
      (SERVICE_NAME = orcl.example.com)
      (SERVER = POOLED)
      (POOL_CONNECTION_CLASS = MY_APP_CLASS)
      (POOL_PURITY = SELF)
    )
  )

# --- External via HTTPS Proxy ---

CLOUDDB =
  (DESCRIPTION =
    (ADDRESS = (PROTOCOL = TCPS)(HOST = adb.eu-frankfurt-1.oraclecloud.com)(PORT = 1522))
    (CONNECT_DATA =
      (SERVICE_NAME = abc123def_clouddb_high.adb.oraclecloud.com)
      (SERVER = DEDICATED)
    )
    (SECURITY =
      (SSL_SERVER_DN_MATCH = ON)
    )
    (HTTPS_PROXY = proxy.example.com)
    (HTTPS_PROXY_PORT = 8080)
  )

# --- Heterogeneous Services (Gateway) ---

MSSQL_LINK =
  (DESCRIPTION =
    (ADDRESS = (PROTOCOL = TCP)(HOST = gwserver.example.com)(PORT = 1521))
    (CONNECT_DATA =
      (SID = mssql_gw)
      (HS = OK)
    )
  )

MYSQL_LINK =
  (DESCRIPTION =
    (ADDRESS = (PROTOCOL = TCP)(HOST = gwserver.example.com)(PORT = 1522))
    (CONNECT_DATA =
      (SID = mysql_gw)
      (HS = OK)
    )
  )
