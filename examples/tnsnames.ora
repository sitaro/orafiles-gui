    (CONNECT_DATA =
      (SERVICE_NAME = testdb.example.com)
      (SERVER = DEDICATED)
    )
  )

QADB =
  (DESCRIPTION =
    (ADDRESS = (PROTOCOL = TCP)(HOST = dbdev01.example.com)(PORT = 1525))
    (CONNECT_DATA =
      (SERVICE_NAME = qadb.example.com)
      (SERVER = DEDICATED)
    )
