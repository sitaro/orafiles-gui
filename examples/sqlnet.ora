# ============================================================
# SQL*Net Configuration - Enterprise Setup
# ============================================================

# --- Naming ---
NAMES.DEFAULT_DOMAIN = example.com
NAMES.DIRECTORY_PATH = (TNSNAMES, LDAP, EZCONNECT)
NAMES.LDAP_AUTHENTICATE_BIND = FALSE
NAMES.LDAP_PERSISTENT_SESSION = FALSE

# --- Encryption (Client) ---
SQLNET.ENCRYPTION_CLIENT = REQUIRED
SQLNET.ENCRYPTION_TYPES_CLIENT = (AES256, AES192, AES128)

# --- Encryption (Server) ---
SQLNET.ENCRYPTION_SERVER = REQUIRED
SQLNET.ENCRYPTION_TYPES_SERVER = (AES256, AES192, AES128)
SQLNET.ALLOW_WEAK_CRYPTO = FALSE

# --- Integrity (Client) ---
SQLNET.CRYPTO_CHECKSUM_CLIENT = REQUIRED
SQLNET.CRYPTO_CHECKSUM_TYPES_CLIENT = (SHA256, SHA384, SHA512)

# --- Integrity (Server) ---
SQLNET.CRYPTO_CHECKSUM_SERVER = REQUIRED
SQLNET.CRYPTO_CHECKSUM_TYPES_SERVER = (SHA256, SHA384, SHA512)

# --- SSL/TLS ---
SSL_VERSION = 1.2
SSL_CLIENT_AUTHENTICATION = FALSE
SSL_CIPHER_SUITES = (TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384, TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256, TLS_RSA_WITH_AES_256_GCM_SHA384)
SSL_SERVER_DN_MATCH = ON
SSL_ALLOW_MD5_CERTS = FALSE
SSL_ALLOW_SHA1_CERTS = FALSE

# --- Authentication ---
SQLNET.AUTHENTICATION_SERVICES = (TCPS, NTS)
SQLNET.ALLOWED_LOGON_VERSION_CLIENT = 12a
SQLNET.ALLOWED_LOGON_VERSION_SERVER = 12a
SQLNET.FALLBACK_AUTHENTICATION = FALSE

# --- Kerberos ---
SQLNET.KERBEROS5_CC_NAME = /tmp/krb5cc_%{uid}
SQLNET.KERBEROS5_CONF = /etc/krb5.conf
SQLNET.KERBEROS5_CLOCKSKEW = 300
SQLNET.KERBEROS5_REALMS = /etc/krb5.conf
SQLNET.KERBEROS5_KEYTAB = /etc/krb5.keytab

# --- Timeouts ---
SQLNET.EXPIRE_TIME = 10
SQLNET.OUTBOUND_CONNECT_TIMEOUT = 30
SQLNET.INBOUND_CONNECT_TIMEOUT = 60
SQLNET.RECV_TIMEOUT = 300
SQLNET.SEND_TIMEOUT = 300
SQLNET.DOWN_HOSTS_TIMEOUT = 600
TCP.CONNECT_TIMEOUT = 10

# --- Performance ---
DEFAULT_SDU_SIZE = 32767
RECV_BUF_SIZE = 65536
SEND_BUF_SIZE = 65536

# --- Compression ---
SQLNET.COMPRESSION = ON
SQLNET.COMPRESSION_LEVELS = (LOW, HIGH)
SQLNET.COMPRESSION_THRESHOLD = 1024

# --- TCP Access Control ---
TCP.VALIDNODE_CHECKING = YES
TCP.INVITED_NODES = (dbprod01.example.com, dbprod02.example.com, dbdwh01.example.com, dbdwh02.example.com, dbdwh03.example.com, dbdev01.example.com, racnode1.example.com, racnode2.example.com, racnode3.example.com, 10.0.1.0/24, 10.0.2.0/24)
TCP.EXCLUDED_NODES = (10.99.0.0/16)
TCP.NODELAY = YES

# --- Advanced ---
DISABLE_OOB = OFF
BEQUEATH_DETACH = YES

# --- Wallet ---
WALLET_LOCATION = (SOURCE = (METHOD = FILE)(METHOD_DATA = (DIRECTORY = /u01/app/oracle/wallet)))
WALLET_OVERRIDE = FALSE

# --- Security Banners ---
SEC_USER_AUDIT_ACTION_BANNER = /u01/app/oracle/network/admin/audit_banner.txt
SEC_USER_UNAUTHORIZED_ACCESS_BANNER = /u01/app/oracle/network/admin/unauth_banner.txt

# --- Misc ---
SQLNET.CLIENT_REGISTRATION = app_server_01
USE_DEDICATED_SERVER = OFF

# --- Logging ---
TNSPING.TRACE_LEVEL = OFF
TNSPING.TRACE_DIRECTORY = /u01/app/oracle/diag/tnsping
